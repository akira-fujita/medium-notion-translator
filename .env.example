# === Notion 設定（必須）===
# https://www.notion.so/profile/integrations で作成
NOTION_API_KEY=ntn_your_api_key_here
NOTION_DATABASE_ID=your_database_id_here

# === オプション設定 ===
# ブラウザを非表示で実行（初回ログイン後に true に変更推奨）
HEADLESS=false

# ログレベル（DEBUG / INFO / WARNING / ERROR）
LOG_LEVEL=INFO

# Claude Code のモデル（sonnet / opus / haiku）
CLAUDE_MODEL=sonnet

# === Slack 通知（オプション）===
# bookmark --run 完了時に翻訳結果を Slack に通知
# https://api.slack.com/messaging/webhooks で Incoming Webhook を作成
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# === 視覚版 HTML（図とクイズ）===
# 翻訳ページの「## 要約」の直前に埋め込む。既定は作る。止めるときだけ false
# VISUAL_HTML=false
# 作り方の正本（my-skills の notion-visual-primer）の場所
# VISUAL_PRIMER_DIR=~/.claude/skills/notion-visual-primer

# === radar（RSS ダイジェスト）===
# Tech Radar 用の Notion DB（翻訳 DB とは別に作成し Integration を接続）
# RADAR_NOTION_DATABASE_ID=your_radar_database_id_here
# radar 専用 Slack Webhook（未設定なら上の SLACK_WEBHOOK_URL を使用）
# RADAR_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/RADAR/WEBHOOK
